---
import site from '../../content/site.json';
---

<section id="contact" class="py-24 bg-gray-50 dark:bg-[#16161e]" aria-labelledby="contact-heading">
  <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div data-animate>
      <p class="text-sm font-semibold tracking-widest text-violet-600 dark:text-violet-400 uppercase mb-3">
        Get in Touch
      </p>
      <h2 id="contact-heading" class="font-display text-4xl font-bold text-gray-900 dark:text-gray-50 mb-4">
        Let's connect.
      </h2>
      <p class="text-lg text-gray-500 dark:text-gray-400 mb-12 max-w-lg mx-auto leading-relaxed">
        Open to data engineering roles, collaborations, or just a conversation about data contracts, pipelines, or AI evaluation.
      </p>

      <!-- Contact options -->
      <div class="grid sm:grid-cols-3 gap-4 mb-10">
        <!-- Email -->
        <a
          href={`mailto:${site.email}`}
          class="group flex flex-col items-center gap-3 p-6 bg-white dark:bg-[#1e1e2a] rounded-2xl border border-gray-100 dark:border-gray-800 hover:border-violet-300 dark:hover:border-violet-700 hover:-translate-y-1 transition-all"
        >
          <div class="w-12 h-12 rounded-xl bg-violet-100 dark:bg-violet-900/40 flex items-center justify-center text-violet-600 dark:text-violet-400 group-hover:bg-violet-600 group-hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 0 0 2.22 0L21 8M5 19h14a2 2 0 0 0 2-2V7a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2z" />
            </svg>
          </div>
          <div>
            <p class="font-semibold text-sm text-gray-900 dark:text-gray-100">Email</p>
            <p class="text-xs text-gray-500 dark:text-gray-400 break-all">{site.email}</p>
          </div>
        </a>

        <!-- LinkedIn -->
        <a
          href={site.linkedin}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col items-center gap-3 p-6 bg-white dark:bg-[#1e1e2a] rounded-2xl border border-gray-100 dark:border-gray-800 hover:border-violet-300 dark:hover:border-violet-700 hover:-translate-y-1 transition-all"
        >
          <div class="w-12 h-12 rounded-xl bg-blue-100 dark:bg-blue-900/40 flex items-center justify-center text-blue-600 dark:text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-sm text-gray-900 dark:text-gray-100">LinkedIn</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">nurulfatinamira</p>
          </div>
        </a>

        <!-- GitHub -->
        <a
          href={site.github}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex flex-col items-center gap-3 p-6 bg-white dark:bg-[#1e1e2a] rounded-2xl border border-gray-100 dark:border-gray-800 hover:border-violet-300 dark:hover:border-violet-700 hover:-translate-y-1 transition-all"
        >
          <div class="w-12 h-12 rounded-xl bg-gray-100 dark:bg-gray-800 flex items-center justify-center text-gray-700 dark:text-gray-300 group-hover:bg-gray-900 group-hover:text-white dark:group-hover:bg-gray-100 dark:group-hover:text-gray-900 transition-colors">
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
              <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
            </svg>
          </div>
          <div>
            <p class="font-semibold text-sm text-gray-900 dark:text-gray-100">GitHub</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">watnoffin</p>
          </div>
        </a>
      </div>

      <p class="text-sm text-gray-400 dark:text-gray-500">
        References available upon request.
      </p>
    </div>
  </div>
</section>
