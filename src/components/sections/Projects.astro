---
const base = import.meta.env.BASE_URL;

// We'll read project frontmatter manually since we're not using Astro content collections yet
const projects = [
  {
    slug: 'data-contract-framework',
    title: 'Data Contract Framework & Toolkit',
    summary: 'A contract-driven data engineering system built on ODCS v3.0.2, Databricks, and dbt — where every dataset is governed by a machine-readable contract enforced at build time.',
    tags: ['ODCS', 'Databricks', 'dbt', 'Data Contracts'],
    type: 'work',
    github: null,
    award: null,
  },
  {
    slug: 'hallucination-detection-tool',
    title: 'Hallucination Detection Tool',
    summary: 'A Databricks App with a Streamlit review UI and a data ingestion notebook to detect and track LLM hallucinations — making AI evaluation systematic and auditable.',
    tags: ['Databricks', 'Streamlit', 'Python', 'LLM Evaluation'],
    type: 'personal',
    github: 'https://github.com/watnoffin/hallucination-detection-tool',
    award: null,
  },
  {
    slug: 'inspectron',
    title: 'INSPECTRON — AI Home Inspection Generator',
    summary: 'Detects structural defects from uploaded photos using Gemini API and generates professional inspection reports via IBM watsonx.ai.',
    tags: ['IBM watsonx.ai', 'Gemini API', 'Python', 'Computer Vision'],
    type: 'personal',
    github: null,
    award: 'Champion — Bridgehack to Industry (UiTM × IBM, 2024)',
  },
  {
    slug: 'gradtrack',
    title: 'GradTrack — Graduate Employment Analytics',
    summary: 'End-to-end pipeline from survey data collection to Power BI dashboards, statistical analysis of satisfaction metrics, and predictive modelling in Python.',
    tags: ['Power BI', 'Python', 'Statistical Analysis', 'Pandas'],
    type: 'personal',
    github: null,
    award: null,
  },
];
---

<section id="projects" class="py-24 bg-gray-50 dark:bg-[#16161e]" aria-labelledby="projects-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <p class="text-sm font-semibold tracking-widest text-violet-600 dark:text-violet-400 uppercase mb-3">
        Portfolio
      </p>
      <h2 id="projects-heading" class="font-display text-4xl font-bold text-gray-900 dark:text-gray-50">
        Featured Projects
      </h2>
      <p class="mt-4 text-gray-500 dark:text-gray-400 max-w-xl mx-auto">
        From enterprise data contracts to AI applications — each project solves a real problem with a real pipeline.
      </p>
    </div>

    <div class="grid sm:grid-cols-2 gap-6">
      {projects.map((project, i) => (
        <article
          class="group relative bg-white dark:bg-[#1e1e2a] rounded-2xl border border-gray-100 dark:border-gray-800 p-6 hover:border-violet-300 dark:hover:border-violet-700 hover:-translate-y-1 transition-all duration-200"
          data-animate
          style={`transition-delay: ${i * 80}ms`}
        >
          <!-- Type badge -->
          <div class="flex items-start justify-between mb-4">
            <span class={`inline-flex items-center px-2.5 py-1 rounded-full text-xs font-semibold ${project.type === 'work' ? 'bg-violet-100 dark:bg-violet-900/40 text-violet-700 dark:text-violet-300' : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400'}`}>
              {project.type === 'work' ? 'Professional' : 'Personal'}
            </span>
            {project.award && (
              <span class="inline-flex items-center gap-1 text-xs font-semibold text-amber-600 dark:text-amber-400">
                <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
                  <path fill-rule="evenodd" d="M10 1l2.928 5.935 6.072.883-4.394 4.283 1.036 6.041L10 15.167l-5.642 2.975 1.036-6.041L1 7.818l6.072-.883z" clip-rule="evenodd"/>
                </svg>
                Champion
              </span>
            )}
          </div>

          <h3 class="font-display text-xl font-bold text-gray-900 dark:text-gray-50 mb-3 group-hover:text-violet-600 dark:group-hover:text-violet-400 transition-colors">
            {project.title}
          </h3>
          <p class="text-sm text-gray-600 dark:text-gray-300 leading-relaxed mb-4">{project.summary}</p>

          <!-- Tags -->
          <ul class="flex flex-wrap gap-2 mb-5" role="list" aria-label="Technologies">
            {project.tags.map((tag) => (
              <li>
                <span class="px-2.5 py-1 bg-violet-50 dark:bg-violet-900/20 text-violet-700 dark:text-violet-300 text-xs font-medium rounded-lg">
                  {tag}
                </span>
              </li>
            ))}
          </ul>

          <!-- Actions -->
          <div class="flex items-center gap-3 mt-auto">
            <a
              href={`${base}projects/${project.slug}/`}
              class="inline-flex items-center gap-1.5 text-sm font-semibold text-violet-600 dark:text-violet-400 hover:text-violet-700 dark:hover:text-violet-300 transition-colors"
              aria-label={`View case study for ${project.title}`}
            >
              Case Study
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
              </svg>
            </a>
            {project.github && (
              <a
                href={project.github}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-sm text-gray-500 dark:text-gray-400 hover:text-gray-700 dark:hover:text-gray-200 transition-colors"
                aria-label={`GitHub repository for ${project.title}`}
              >
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"/>
                </svg>
                GitHub
              </a>
            )}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
