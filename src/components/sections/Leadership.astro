---
import leadership from '../../content/leadership.json';
---

<section id="leadership" class="py-24 bg-white dark:bg-[#0f0f14]" aria-labelledby="leadership-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <p class="text-sm font-semibold tracking-widest text-violet-600 dark:text-violet-400 uppercase mb-3">
        Beyond Work
      </p>
      <h2 id="leadership-heading" class="font-display text-4xl font-bold text-gray-900 dark:text-gray-50">
        Leadership & Activities
      </h2>
    </div>

    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-5" data-animate>
      {leadership.map((item) => (
        <div class="bg-gray-50 dark:bg-[#1e1e2a] rounded-2xl border border-gray-100 dark:border-gray-800 p-5 hover:border-violet-200 dark:hover:border-violet-800 transition-colors">
          <p class="text-xs font-semibold text-violet-600 dark:text-violet-400 uppercase tracking-wide mb-2">{item.period}</p>
          <h3 class="font-display font-bold text-gray-900 dark:text-gray-100 text-sm leading-snug mb-1">{item.role}</h3>
          <p class="text-xs font-semibold text-gray-500 dark:text-gray-400">{item.org}</p>
          <p class="text-xs text-gray-500 dark:text-gray-500 mt-2 leading-relaxed">{item.detail}</p>
        </div>
      ))}
    </div>
  </div>
</section>
