---
import site from '../../content/site.json';
const base = import.meta.env.BASE_URL;
---

<section
  id="hero"
  class="relative min-h-screen flex items-center pt-16 overflow-hidden"
  aria-label="Hero — introduction"
>
  <!-- Background grid decoration -->
  <div class="absolute inset-0 -z-10 overflow-hidden" aria-hidden="true">
    <div
      class="absolute inset-0 opacity-[0.03] dark:opacity-[0.06]"
      style="background-image: radial-gradient(circle, #7c3aed 1px, transparent 1px); background-size: 32px 32px;"
    ></div>
    <!-- Accent blobs -->
    <div class="absolute top-1/4 right-1/4 w-96 h-96 bg-violet-500/10 dark:bg-violet-500/15 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 left-1/3 w-64 h-64 bg-indigo-500/10 dark:bg-indigo-500/10 rounded-full blur-3xl"></div>
  </div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-20 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">

      <!-- Text content -->
      <div>
        <p class="fade-in text-sm font-semibold tracking-widest text-violet-600 dark:text-violet-400 uppercase mb-4">
          Data Engineer
        </p>
        <h1 class="fade-in fade-in-delay-1 font-display text-5xl sm:text-6xl lg:text-7xl font-extrabold text-gray-900 dark:text-gray-50 leading-tight tracking-tight mb-6">
          Hi, I'm<br />
          <span class="text-violet-600 dark:text-violet-400">Fatin.</span>
        </h1>
        <p class="fade-in fade-in-delay-2 text-xl sm:text-2xl text-gray-600 dark:text-gray-300 font-medium leading-relaxed mb-4">
          {site.tagline}
        </p>
        <p class="fade-in fade-in-delay-3 text-base text-gray-500 dark:text-gray-400 leading-relaxed mb-10 max-w-lg">
          Databricks · dbt · IBM IIDR · Netezza · Qlik · Tableau · Power BI
        </p>

        <div class="fade-in fade-in-delay-4 flex flex-wrap gap-4">
          <a
            href="#projects"
            class="inline-flex items-center gap-2 px-6 py-3 bg-violet-600 text-white font-semibold rounded-xl hover:bg-violet-700 transition-all hover:-translate-y-0.5 shadow-lg shadow-violet-500/25"
          >
            View Projects
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6" />
            </svg>
          </a>
          <a
            href={`${base}cv.pdf`}
            download
            class="inline-flex items-center gap-2 px-6 py-3 bg-white dark:bg-gray-900 text-gray-900 dark:text-gray-100 font-semibold rounded-xl border border-gray-200 dark:border-gray-700 hover:border-violet-400 dark:hover:border-violet-500 transition-all hover:-translate-y-0.5"
          >
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3M3 17v3a1 1 0 001 1h16a1 1 0 001-1v-3" />
            </svg>
            Download CV
          </a>
          <a
            href="#contact"
            class="inline-flex items-center gap-2 px-6 py-3 text-violet-600 dark:text-violet-400 font-semibold rounded-xl border border-violet-200 dark:border-violet-800 hover:bg-violet-50 dark:hover:bg-violet-900/20 transition-all hover:-translate-y-0.5"
          >
            Contact
          </a>
        </div>
      </div>

      <!-- Profile photo / monogram -->
      <div class="flex justify-center lg:justify-end">
        <div class="relative">
          <!-- Decorative ring -->
          <div
            class="absolute -inset-3 rounded-full bg-gradient-to-br from-violet-500/30 to-indigo-500/20 blur-xl"
            aria-hidden="true"
          ></div>
          <!-- Photo slot — shows initials monogram as fallback -->
          <!-- TODO(owner): Replace this div with an <img> tag pointing to your photo:
               <img src="/portfolio-web/photo.webp" alt="Nurul Fatin Amira Binti Mohd Riza — profile photo"
                    class="relative w-64 h-64 lg:w-80 lg:h-80 rounded-full object-cover border-4 border-white dark:border-gray-900 shadow-2xl" />
          -->
          <div
            class="relative w-64 h-64 lg:w-80 lg:h-80 rounded-full bg-gradient-to-br from-violet-100 to-indigo-100 dark:from-violet-900/40 dark:to-indigo-900/40 border-4 border-white dark:border-gray-800 shadow-2xl flex items-center justify-center"
            role="img"
            aria-label="Profile photo placeholder — initials NFA"
          >
            <span class="font-display font-extrabold text-7xl lg:text-8xl text-violet-600 dark:text-violet-400 select-none">
              NFA
            </span>
          </div>

          <!-- Location badge -->
          <div class="absolute -bottom-3 left-1/2 -translate-x-1/2 flex items-center gap-1.5 px-4 py-1.5 bg-white dark:bg-gray-900 rounded-full shadow-lg border border-gray-100 dark:border-gray-700 text-xs font-medium text-gray-600 dark:text-gray-300 whitespace-nowrap">
            <svg class="w-3.5 h-3.5 text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a2 2 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Seremban, Malaysia
          </div>
        </div>
      </div>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-gray-400 dark:text-gray-600 animate-bounce" aria-hidden="true">
      <span class="text-xs">Scroll</span>
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
      </svg>
    </div>
  </div>
</section>
