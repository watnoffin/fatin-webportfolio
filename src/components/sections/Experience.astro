---
import experience from '../../content/experience.json';
---

<section id="experience" class="py-24 bg-white dark:bg-[#0f0f14]" aria-labelledby="experience-heading">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16" data-animate>
      <p class="text-sm font-semibold tracking-widest text-violet-600 dark:text-violet-400 uppercase mb-3">
        Career
      </p>
      <h2 id="experience-heading" class="font-display text-4xl font-bold text-gray-900 dark:text-gray-50">
        Experience
      </h2>
    </div>

    <!-- Timeline -->
    <div class="relative max-w-3xl mx-auto">
      <!-- Vertical line -->
      <div
        class="absolute left-6 top-0 bottom-0 w-px bg-gradient-to-b from-violet-500 via-violet-300 to-transparent dark:from-violet-500 dark:via-violet-700 dark:to-transparent"
        aria-hidden="true"
      ></div>

      <ol class="space-y-12" role="list">
        {experience.map((job) => (
          <li class="relative pl-16" data-animate>
            <!-- Timeline dot -->
            <div
              class={`absolute left-4 top-1 w-5 h-5 rounded-full border-2 border-white dark:border-[#0f0f14] shadow-md ${job.current ? 'bg-violet-600' : 'bg-gray-300 dark:bg-gray-600'}`}
              aria-hidden="true"
            ></div>
            {job.current && (
              <div
                class="absolute left-4 top-1 w-5 h-5 rounded-full bg-violet-400/40 animate-ping"
                aria-hidden="true"
              ></div>
            )}

            <div class="bg-white dark:bg-[#1e1e2a] rounded-2xl border border-gray-100 dark:border-gray-800 p-6 hover:border-violet-200 dark:hover:border-violet-800 transition-colors">
              <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                <div>
                  <h3 class="font-display text-xl font-bold text-gray-900 dark:text-gray-50">{job.role}</h3>
                  <p class="text-violet-600 dark:text-violet-400 font-semibold">{job.company}</p>
                </div>
                <div class="text-right">
                  <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-semibold ${job.current ? 'bg-violet-100 dark:bg-violet-900/40 text-violet-700 dark:text-violet-300' : 'bg-gray-100 dark:bg-gray-800 text-gray-600 dark:text-gray-400'}`}>
                    {job.current ? 'Current' : 'Past'}
                  </span>
                  <p class="text-sm text-gray-500 dark:text-gray-400 mt-1">
                    {job.startDate}{job.endDate ? ` – ${job.endDate}` : ''}
                  </p>
                </div>
              </div>

              <ul class="space-y-2" role="list">
                {job.highlights.map((point) => (
                  <li class="flex gap-3 text-sm text-gray-600 dark:text-gray-300">
                    <svg class="w-4 h-4 mt-0.5 flex-shrink-0 text-violet-500" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" />
                    </svg>
                    <span>{point}</span>
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
