---
import PageLayout from '../../layouts/PageLayout.astro';

// Static route generation for all 4 projects
export async function getStaticPaths() {
  const projects = [
    {
      slug: 'data-contract-framework',
      title: 'Data Contract Framework & Data Engineering Toolkit',
      description: 'A contract-driven data engineering system built on ODCS v3.0.2, Databricks, and dbt — where every dataset is governed by a machine-readable contract enforced at build time.',
      tags: ['ODCS v3.0.2', 'Databricks', 'dbt', 'Data Contracts', 'SQL', 'YAML'],
      type: 'work',
      github: null,
      award: null,
    },
    {
      slug: 'hallucination-detection-tool',
      title: 'Hallucination Detection Tool',
      description: 'A Databricks App with a Streamlit review UI and a data ingestion notebook to detect and track LLM hallucinations — making AI evaluation systematic and auditable.',
      tags: ['Databricks', 'Streamlit', 'Python', 'Delta Lake', 'LLM Evaluation'],
      type: 'personal',
      github: 'https://github.com/watnoffin/hallucination-detection-tool',
      award: null,
    },
    {
      slug: 'inspectron',
      title: 'INSPECTRON — AI Home Inspection Generator',
      description: 'Champion project at Bridgehack to Industry (UiTM × IBM, 2024). Detects structural defects from photos using Gemini API and generates inspection reports via IBM watsonx.ai.',
      tags: ['IBM watsonx.ai', 'Gemini API', 'Python', 'Computer Vision', 'Prompt Engineering'],
      type: 'personal',
      github: null,
      award: 'Champion — Bridgehack to Industry (UiTM × IBM, 2024)',
    },
    {
      slug: 'gradtrack',
      title: 'GradTrack — Graduate Employment Analytics',
      description: 'Final Year Project: survey collection to Power BI dashboards, statistical analysis of satisfaction metrics, and predictive modelling in Python.',
      tags: ['Power BI', 'Python', 'Pandas', 'NumPy', 'Statistical Analysis'],
      type: 'personal',
      github: null,
      award: null,
    },
  ];
  return projects.map((p) => ({ params: { slug: p.slug }, props: p }));
}

const { slug, title, description, tags, type, github, award } = Astro.props;
const base = import.meta.env.BASE_URL;

// ── Inline content per project ──────────────────────────────────────────────

type Diagram = { lines: string[] };
type Section = { heading: string; body: string[]; listItems?: string[]; diagram?: Diagram };

interface ProjectContent {
  problem: string;
  role: string;
  approach: Section[];
  outcome: string;
  confidentialNote?: string;
}

const contents: Record<string, ProjectContent> = {
  'data-contract-framework': {
    problem:
      'Modern data teams share datasets without formal agreements on schema, ownership, quality rules, or change processes. The result is silent breakages, undefined SLAs, and engineers discovering failures only when a downstream dashboard stops loading. A data contract makes those agreements explicit, machine-readable, and enforced at build time.',
    role:
      'Contributed to the design and implementation of the internal Data Engineering Toolkit and its Data Contract Framework. Authored contract templates (Excel-to-YAML) covering schema definitions, ownership metadata, quality rules, and SCD behaviour. Prepared an internal presentation introducing data contracts, the toolkit\'s four modules, and dbt as the enforcement layer.',
    approach: [
      {
        heading: 'Three-Layer Architecture',
        body: [
          'The system is organised in three conceptual layers: the contract artifact, the toolkit framework, and the dbt enforcement engine. Each layer has a single responsibility.',
        ],
      },
      {
        heading: 'Contract Anatomy (ODCS v3.0.2)',
        body: [
          'Each contract is an ODCS-compliant YAML file that covers schema (column names, types, nullability), ownership (domain, team, steward), quality (freshness SLAs, row-count thresholds, uniqueness rules), and SCD type with tracked columns and effective date logic.',
        ],
      },
      {
        heading: 'The Four Toolkit Modules',
        body: [],
        listItems: [
          'Template Generator — converts an Excel spec into a valid ODCS YAML file.',
          'Validator — parses YAML against the ODCS schema and custom business rules before any model runs.',
          'Lineage Registry — records contract-to-model relationships so impact analysis is automatic.',
          'Enforcement Bridge — translates contract quality rules into dbt test blocks, keeping tests in sync with the contract.',
        ],
      },
      {
        heading: 'dbt as the Enforcement Engine',
        body: [
          'At build time, schema mismatches fail the run immediately. Quality assertions (freshness, uniqueness, custom SQL tests) are generated from the contract, not written by hand. SCD models are generated with the correct strategy derived from the contract\'s SCD block. The contract is the single source of truth.',
        ],
      },
    ],
    outcome:
      'The framework established a repeatable, auditable pattern for data governance — shifting quality enforcement from reactive debugging to proactive contract validation at build time.',
    confidentialNote:
      'Details generalised to respect confidentiality. No internal server names, hostnames, tool configurations, or document names are included.',
  },
  'hallucination-detection-tool': {
    problem:
      'Large language models hallucinate — generating plausible-sounding but factually incorrect outputs. Without a systematic review process, hallucinations in production AI applications are discovered by users, not engineers. This project provides a structured ingestion and review pipeline to catch them early.',
    role:
      'Sole developer. Designed and built the full pipeline: data ingestion notebook, review UI, and the Databricks App deployment configuration.',
    approach: [
      {
        heading: 'Ingestion Notebook',
        body: [
          'Reads LLM output records (prompt, generated response, ground-truth answer). Applies a lightweight normalisation schema so that records from different models are comparable. Writes to a Delta table partitioned by date and model identifier with review_status = "pending".',
        ],
      },
      {
        heading: 'Streamlit Review UI',
        body: [
          'Presents one record at a time: prompt on the left, model response on the right, expected answer below. Three-button classification: Correct, Hallucination, Unclear. Optional free-text notes for borderline cases. Progress indicator showing remaining unreviewed records.',
        ],
      },
      {
        heading: 'Databricks App Deployment',
        body: [
          'The app runs natively on Databricks Apps — no separate infrastructure to manage. Compute, auth, and storage are all within the same Databricks workspace. The Streamlit app reads and writes directly to Delta tables using the Databricks SDK.',
        ],
      },
    ],
    outcome:
      'A repeatable, auditable pipeline for LLM quality evaluation — shifting hallucination discovery from reactive user reports to a structured reviewer workflow with a queryable audit trail.',
  },
  inspectron: {
    problem:
      'Home inspections are time-consuming, expensive, and dependent on the availability of qualified inspectors. Property buyers and landlords often defer them, and when defects go undetected, small problems compound into costly repairs. INSPECTRON makes a first-pass inspection accessible from a smartphone photo.',
    role:
      'Team member (Champion team). Contributed to defect detection pipeline design, API integration with Gemini and IBM watsonx.ai, and report generation logic.',
    approach: [
      {
        heading: 'Defect Detection with Gemini API',
        body: [
          'Gemini\'s vision capability receives a structured prompt instructing it to identify specific defect categories (cracks, mold, water damage, structural anomalies) and return a JSON list of findings with location descriptions. Structured output feeds directly into the next stage without manual parsing.',
        ],
      },
      {
        heading: 'Severity Classification',
        body: [
          'A deterministic mapping layer converts Gemini\'s defect type labels into severity levels (Low → Critical), ensuring consistent classification independent of LLM variability.',
        ],
      },
      {
        heading: 'Report Generation with IBM watsonx.ai',
        body: [
          'IBM watsonx.ai receives the structured defect list and generates a professional-tone inspection report: an executive summary of overall property condition, a per-defect section with severity and recommended repair action, and a priority list for urgent attention.',
        ],
      },
    ],
    outcome:
      'Champion at Bridgehack to Industry (UiTM × IBM, September–October 2024). The prototype demonstrated that a two-API pipeline (vision + language model) could produce inspection reports comparable in structure and depth to a professional report, from a single photo upload.',
  },
  gradtrack: {
    problem:
      'University career offices and programme directors lack a systematic, data-driven view of how graduates are faring in the job market — and whether satisfaction with their degree correlates with employment outcomes. GradTrack provides that view.',
    role:
      'Sole researcher and developer for my Final Year Project. Designed the survey instrument, collected and cleaned the data, built the analytical pipeline, and delivered the Power BI dashboard.',
    approach: [
      {
        heading: 'Survey Design & Collection',
        body: [
          'The survey captured both factual employment data (status, time-to-first-job, sector) and satisfaction metrics across curriculum relevance, career support, and overall experience — enabling correlation analysis between programme quality perceptions and outcomes.',
        ],
      },
      {
        heading: 'Cleaning & Preparation (Python / Pandas)',
        body: [
          'Standardised free-text categorical entries, applied median imputation for numeric fields with low missingness, and flagged records with excessive missing data for exclusion. Derived a composite satisfaction score from Likert-scale responses.',
        ],
      },
      {
        heading: 'Statistical Analysis',
        body: [
          'Correlation analysis identified which satisfaction dimensions most strongly associate with employment outcomes. Group comparisons tested whether differences across programmes were statistically significant.',
        ],
      },
      {
        heading: 'Predictive Modelling',
        body: [
          'A binary classification model (employed vs. not employed within six months) was trained on GPA, satisfaction scores, and field-of-study features. Feature importance analysis surfaced the most predictive inputs.',
        ],
      },
      {
        heading: 'Power BI Dashboard',
        body: [
          'The final deliverable is an interactive Power BI report allowing programme directors to drill into employment rates, satisfaction breakdowns, and predictive scores by cohort — turning analysis into an actionable planning tool.',
        ],
      },
    ],
    outcome:
      'Delivered a complete, end-to-end analytics pipeline from raw survey data to an interactive dashboard and predictive model — demonstrating the full data engineering and analytics lifecycle as a Final Year Project.',
  },
};

const content = contents[slug];

