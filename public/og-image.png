<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <rect width="1200" height="630" fill="#0f0f14"/>
  <!-- Grid dots -->
  <defs>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <circle cx="20" cy="20" r="1" fill="#ffffff" opacity="0.06"/>
    </pattern>
  </defs>
  <rect width="1200" height="630" fill="url(#grid)"/>
  <!-- Accent blur -->
  <ellipse cx="900" cy="200" rx="350" ry="250" fill="#7c3aed" opacity="0.15"/>
  <!-- Name -->
  <text x="80" y="240" font-family="Plus Jakarta Sans, system-ui, sans-serif" font-size="72" font-weight="800" fill="#f3f4f6" letter-spacing="-2">Nurul Fatin Amira</text>
  <!-- Title -->
  <text x="82" y="320" font-family="Inter, system-ui, sans-serif" font-size="36" font-weight="500" fill="#a78bfa">Data Engineer</text>
  <!-- Tagline -->
  <text x="82" y="390" font-family="Inter, system-ui, sans-serif" font-size="24" fill="#6b7280">Building reliable data pipelines — from contract to insight.</text>
  <!-- Tech stack -->
  <text x="82" y="460" font-family="Inter, system-ui, sans-serif" font-size="18" fill="#4b5563">Databricks · dbt · IBM IIDR · Netezza · Qlik · Tableau · Power BI</text>
  <!-- Location -->
  <text x="82" y="540" font-family="Inter, system-ui, sans-serif" font-size="18" fill="#374151">Seremban, Malaysia</text>
  <!-- Accent rect -->
  <rect x="80" y="270" width="6" height="50" rx="3" fill="#7c3aed"/>
</svg>
